{
  "expo": {
    "name": "Thalos",
    "slug": "thalos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/thalos-icon.png",
    "scheme": "thalosmobile",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/thalos-adaptive.png",
        "monochromeImage": "./assets/images/thalos-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/thalos-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/thalos-symbol.png",
          "imageWidth": 90
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
