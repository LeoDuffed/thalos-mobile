# Usa la configuración pública de la misma aplicación web de Firebase.
# Copia este archivo a .env.local y completa los valores de tu proyecto.
# Expo incluye EXPO_PUBLIC_ en la app: aquí no van contraseñas ni llaves privadas.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_TELEMETRY_DEVICE_ID=robot-01
